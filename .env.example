# Firebase (plan Spark / gratuito).
# Copia este archivo a .env y rellena con los valores de tu proyecto:
# Firebase Console > Configuracion del proyecto > Tus apps > App web.
#
# Estas claves son PUBLICAS por diseno (van dentro del bundle de la app).
# La seguridad real vive en firestore.rules, no en ocultar estas claves.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
