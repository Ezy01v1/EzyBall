{
  "expo": {
    "name": "EzyBall",
    "slug": "ezyball",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ezyball",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131313",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ezyball.app",
      "infoPlist": {
        "NSCameraUsageDescription": "EzyBall usa la camara para detectar tus tiros. El video se procesa en tu telefono y no se sube a ningun servidor.",
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.ezyball.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#212A2F"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#131313"
        }
      ],
      "expo-dev-client",
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": true,
          "enableAndroidGpuLibraries": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1c35c443-c9b3-4154-8948-265dbf38d907"
      }
    },
    "owner": "ezy01v1s-team",
    "icon": "./assets/icon.png"
  }
}
